/* ========== 基础 ========== */
:root {
  /* 第 7 步会换成裁剪后的中文像素字体 */
  --font: "PingFang SC", "Noto Sans SC", "Source Han Sans SC", "Microsoft YaHei", system-ui, sans-serif;
  --ink: #f2f0ea;
  --ink-dim: rgba(242, 240, 234, 0.55);
  --paper: #f2f0ea;
  --bt-blue: #6cc4ff;
  --px: 4px;
  /* 像素圆角：四个角各切掉一个像素 */
  --notch: polygon(
    0 var(--px), var(--px) var(--px), var(--px) 0,
    calc(100% - var(--px)) 0, calc(100% - var(--px)) var(--px), 100% var(--px),
    100% calc(100% - var(--px)), calc(100% - var(--px)) calc(100% - var(--px)), calc(100% - var(--px)) 100%,
    var(--px) 100%, var(--px) calc(100% - var(--px)), 0 calc(100% - var(--px))
  );
}

* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

